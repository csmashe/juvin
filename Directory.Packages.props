<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Avalonia" Version="12.0.1"/>
        <PackageVersion Include="Avalonia.Desktop" Version="12.0.1"/>
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.1"/>
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.0.1"/>
        <PackageVersion Include="FluentIcons.Avalonia" Version="2.1.323"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12"/>
        <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12"/>
        <PackageVersion Include="SharpHook" Version="5.3.9"/>
        <PackageVersion Include="Sentry" Version="6.12.1"/>
        <!-- Must match the Tmds.DBus.Protocol version Avalonia.FreeDesktop 12.0.1 depends on.
             A newer version changes types Avalonia loads during X11 startup and the app fails
             to launch with a TypeLoadException. Recheck after every Avalonia upgrade. -->
        <PackageVersion Include="Tmds.DBus.Protocol" Version="0.92.0"/>
    </ItemGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2"/>
    </ItemGroup>
</Project>
