<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Juvin.App.ViewModels"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:controls="using:Juvin.App.Views.Controls"
        xmlns:loc="using:Juvin.App.Localization"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="640"
        x:Class="Juvin.App.Views.SetupWizard"
        x:DataType="vm:SetupWizardViewModel"
        Title="{loc:Str Wizard.Title}"
        Icon="/Assets/juvin-mark-color-256.png"
        Width="640" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,32,0,20" Spacing="6">
            <TextBlock Classes="wordmark" Text="{loc:Str App.Name}" HorizontalAlignment="Center" />
            <TextBlock Classes="tagline" Text="{loc:Str App.Tagline}" HorizontalAlignment="Center" />
            <ItemsControl Margin="0,10,0,0" HorizontalAlignment="Center" ItemsSource="{Binding StepDots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StepDot">
                        <Border Classes="step-dot" Classes.active="{Binding IsActive}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Classes="tagline" Text="{Binding StepText}" HorizontalAlignment="Center" FontSize="11" />
        </StackPanel>

        <!-- The tab strip is hidden; StepIndex picks the page. Tabs follow SetupWizardStep order. -->
        <TabControl Grid.Row="1" Classes="steps" SelectedIndex="{Binding StepIndex}" Margin="32,0">

            <TabItem>
                <StackPanel Spacing="14" Margin="0,0,14,0">
                    <TextBlock Classes="page-title" Text="{loc:Str Wizard.Welcome.Title}" />
                    <TextBlock Classes="page-subtitle" Text="{loc:Str Wizard.Welcome.Body}" />
                    <Border Classes="panel">
                        <StackPanel>
                            <Border Classes="section-row">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Classes="row-title" Text="{loc:Str Wizard.Welcome.CrashReports}" />
                                        <TextBlock Classes="row-hint" Text="{loc:Str Wizard.Welcome.CrashReportsHint}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  IsEnabled="{Binding IsCrashReportingAvailable}"
                                                  IsChecked="{Binding CrashReportingEnabled}" />
                                </Grid>
                            </Border>
                            <Border Classes="section-row divided" IsVisible="{Binding !IsCrashReportingAvailable}">
                                <TextBlock Classes="row-hint" Margin="0" Text="{loc:Str PrivacyAndData.CrashUnavailable}" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,14,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="page-title"
                                       Text="{loc:Str Wizard.Mode.Title}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="{loc:Str Common.CheckAgain}"
                                    Command="{Binding DetectModelsCommand}" />
                        </Grid>
                        <TextBlock Classes="page-subtitle" Text="{loc:Str Wizard.Mode.Body}" />

                        <Border Classes="panel">
                            <StackPanel>
                                <Border Classes="section-row">
                                    <Grid ColumnDefinitions="*,180" ColumnSpacing="16">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Classes="row-title" Text="{loc:Str Models.Mode}" />
                                            <TextBlock Classes="row-hint" Text="{Binding ModeHint}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  ItemsSource="{Binding ModeOptions}"
                                                  SelectedItem="{Binding SelectedMode}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ProcessingModeOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Border Classes="section-row divided" IsVisible="{Binding IsCodexMode}">
                                    <TextBlock Classes="row-hint" Margin="0" Text="{loc:Str Models.CodexConsent}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="section-label" Text="{loc:Str Wizard.Mode.DetectedLabel}" />
                        <Border Classes="panel">
                            <ItemsControl ItemsSource="{Binding Detections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetectionRow">
                                        <Border Classes="section-row">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                <ic:SymbolIcon Classes="status"
                                                               Classes.satisfied="{Binding IsSatisfied}"
                                                               Classes.attention="{Binding NeedsAttention}"
                                                               Symbol="{Binding StatusSymbol}"
                                                               VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="row-title" Text="{Binding Title}" />
                                                    <TextBlock Classes="row-hint" Text="{Binding Summary}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MinWidth="90">
                                                    <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
                                                    <Button Content="{loc:Str Wizard.Mode.Use}"
                                                            HorizontalAlignment="Stretch"
                                                            IsVisible="{Binding CanUse}"
                                                            Command="{Binding $parent[ItemsControl].((vm:SetupWizardViewModel)DataContext).UseServerCommand, FallbackValue={x:Null}}"
                                                            CommandParameter="{Binding}" />
                                                    <Border Classes="badge" HorizontalAlignment="Center" IsVisible="{Binding IsInUse}">
                                                        <TextBlock Classes="badge-text" Text="{loc:Str Wizard.Mode.InUse}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Spacing="14" IsVisible="{Binding !IsCodexMode}">
                            <TextBlock Classes="section-label" Text="{loc:Str Wizard.Mode.ServerLabel}" />
                            <Border Classes="panel">
                                <Border Classes="section-row">
                                    <StackPanel Spacing="10">
                                        <StackPanel>
                                            <TextBlock Classes="row-title" Text="{loc:Str Wizard.Mode.ServerAddress}" />
                                            <TextBlock Classes="row-hint" Text="{loc:Str Wizard.Mode.ServerAddressHint}" />
                                        </StackPanel>
                                        <TextBox x:Name="ServerUrlBox"
                                                 Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter"
                                                            Command="{Binding CommitServerUrlCommand}"
                                                            CommandParameter="{Binding #ServerUrlBox.Text}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                        <TextBlock Classes="row-hint"
                                                   Margin="0"
                                                   Text="{Binding ServerUrlError}"
                                                   IsVisible="{Binding HasServerUrlError}" />
                                    </StackPanel>
                                </Border>
                            </Border>
                        </StackPanel>

                        <Border Classes="panel" IsVisible="{Binding ShowModelPanel}">
                            <StackPanel>
                                <Border Classes="section-row" IsVisible="{Binding HasRecommendation}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Classes="row-title" Text="{loc:Str Wizard.Mode.Recommended}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="row-hint" Text="{Binding RecommendedModel.Label, FallbackValue=''}" />
                                                <Border Classes="badge" IsVisible="{Binding RecommendedModel.IsLowQuality, FallbackValue=False}">
                                                    <TextBlock Classes="badge-text" Text="{loc:Str Models.LowQualityBadge}" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Content="{loc:Str Wizard.Mode.UseModel}"
                                                Command="{Binding UseRecommendedModelCommand}"
                                                IsVisible="{Binding !IsRecommendedModelInUse}" />
                                        <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsRecommendedModelInUse}">
                                            <TextBlock Classes="badge-text" Text="{loc:Str Wizard.Mode.InUse}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Classes="section-row" Classes.divided="{Binding HasRecommendation}" IsVisible="{Binding HasModelAdvice}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row-hint" Margin="0" Text="{Binding ModelAdvice}" />
                                        <TextBlock Classes="row-hint"
                                                   Text="{loc:Str Wizard.Mode.PullHint}"
                                                   IsVisible="{Binding HasPullCommand}" />
                                        <TextBox Text="{Binding PullCommand}"
                                                 IsReadOnly="True"
                                                 FontFamily="monospace"
                                                 FontSize="11"
                                                 IsVisible="{Binding HasPullCommand}" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="section-row" IsVisible="{Binding NoServerFound}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="row-hint" Margin="0" Text="{loc:Str Wizard.Mode.NothingFound}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <HyperlinkButton Content="{loc:Str Wizard.Mode.GetOllama}"
                                                             NavigateUri="https://ollama.com/download" />
                                            <HyperlinkButton Content="{loc:Str Wizard.Mode.GetLmStudio}"
                                                             NavigateUri="https://lmstudio.ai/download" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,14,0">
                        <TextBlock Classes="page-title" Text="{loc:Str Wizard.Connector.Title}" />
                        <TextBlock Classes="page-subtitle" Text="{loc:Str Wizard.Connector.Body}" />
                        <controls:BrowserConnectorPanel DataContext="{Binding Connector}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,14,0">
                        <TextBlock Classes="page-title" Text="{loc:Str Wizard.Shortcut.Title}" />
                        <TextBlock Classes="page-subtitle" Text="{loc:Str Wizard.Shortcut.Body}" />
                        <controls:ShortcutPanel DataContext="{Binding Shortcut}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="page-title"
                                   Text="{loc:Str Wizard.Checklist.Title}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="{loc:Str Common.CheckAgain}"
                                Command="{Binding RecheckSetupCommand}"
                                IsVisible="{Binding HasSetupItems}" />
                    </Grid>
                    <TextBlock Classes="page-subtitle" Text="{loc:Str Wizard.Checklist.Body}" />
                    <Border Classes="panel">
                        <Grid>
                            <Border Classes="section-row" IsVisible="{Binding !HasSetupItems}">
                                <TextBlock Classes="row-hint" Margin="0" Text="{loc:Str Wizard.Checklist.Empty}" />
                            </Border>
                            <ScrollViewer MaxHeight="300" IsVisible="{Binding HasSetupItems}">
                                <ItemsControl ItemsSource="{Binding SetupItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SetupTaskRow">
                                            <Border Classes="section-row">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                        <ic:SymbolIcon Classes="status"
                                                                       Classes.satisfied="{Binding IsSatisfied}"
                                                                       Classes.attention="{Binding NeedsAttention}"
                                                                       Symbol="{Binding StatusSymbol}"
                                                                       VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Classes="row-title" Text="{Binding Title}" />
                                                                <Border Classes="badge">
                                                                    <TextBlock Classes="badge-text" Text="{Binding RequirementLabel}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Classes="row-hint" Text="{Binding Summary}" />
                                                            <TextBlock Classes="row-hint"
                                                                       Text="{Binding Detail}"
                                                                       IsVisible="{Binding HasDetail}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" MinWidth="90">
                                                            <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsBusy}" />
                                                            <Button Content="{Binding ActionLabel}"
                                                                    HorizontalAlignment="Stretch"
                                                                    IsVisible="{Binding CanRunAction}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SetupWizardViewModel)DataContext).RunSetupActionCommand, FallbackValue={x:Null}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBox Text="{Binding CopyCommand}"
                                                             IsReadOnly="True"
                                                             FontFamily="monospace"
                                                             FontSize="11"
                                                             IsVisible="{Binding HasCopyCommand}" />
                                                    <TextBlock Classes="row-hint"
                                                               Text="{Binding ActionMessage}"
                                                               IsVisible="{Binding HasActionMessage}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14" Margin="0,0,14,0">
                        <TextBlock Classes="page-title" Text="{loc:Str Wizard.TryIt.Title}" />
                        <TextBlock Classes="page-subtitle" Text="{Binding TryItBody}" />
                        <Border Classes="panel">
                            <StackPanel>
                                <Border Classes="section-row">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <TextBlock Classes="row-hint"
                                                   Margin="0"
                                                   VerticalAlignment="Center"
                                                   Text="{loc:Str Wizard.TryIt.Hint}"
                                                   IsVisible="{Binding IsBrowserConnected}" />
                                        <TextBlock Grid.Column="0"
                                                   Classes="row-hint"
                                                   Margin="0"
                                                   VerticalAlignment="Center"
                                                   Text="{loc:Str Wizard.TryIt.NoBrowser}"
                                                   IsVisible="{Binding !IsBrowserConnected}" />
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <Button Content="{loc:Str Wizard.TryIt.OpenSample}"
                                                    HorizontalAlignment="Stretch"
                                                    Command="{Binding OpenSampleCommand}"
                                                    IsEnabled="{Binding CanOpenSample}" />
                                            <ProgressBar IsIndeterminate="True" Height="4" IsVisible="{Binding IsOpeningSample}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="section-row divided">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <ic:SymbolIcon Classes="status"
                                                       Classes.satisfied="{Binding IsSampleOpened}"
                                                       Symbol="{Binding SampleOpenedSymbol}"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="row-title" Text="{loc:Str Wizard.TryIt.SampleOpened}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Classes="section-row divided">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <ic:SymbolIcon Classes="status"
                                                       Classes.satisfied="{Binding IsCaptured}"
                                                       Symbol="{Binding CapturedSymbol}"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="row-title" Text="{loc:Str Wizard.TryIt.Captured}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Classes="section-row divided">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <ic:SymbolIcon Classes="status"
                                                       Classes.satisfied="{Binding IsRewriteShown}"
                                                       Symbol="{Binding RewriteShownSymbol}"
                                                       VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="row-title" Text="{loc:Str Wizard.TryIt.RewriteShown}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Classes="section-row divided" IsVisible="{Binding HasTryItStatus}">
                                    <TextBlock Classes="row-hint" Margin="0" Text="{Binding TryItStatus}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <StackPanel Spacing="14">
                    <TextBlock Classes="page-title" Text="{loc:Str Wizard.Done.Title}" />
                    <TextBlock Classes="page-subtitle" Text="{Binding DoneBody}" />
                </StackPanel>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="32,16,32,24" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.ColumnSpan="4"
                       Classes="row-hint"
                       Foreground="{StaticResource JuvinAccentBrush}"
                       Text="{Binding SaveError}"
                       IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Margin="0,0,0,12" />
            <Button Grid.Row="1" Grid.Column="0"
                    Content="{loc:Str Common.Back}"
                    Command="{Binding BackCommand}"
                    IsEnabled="{Binding !IsFirstStep}" />
            <Button Grid.Row="1" Grid.Column="2"
                    Content="{loc:Str Common.Skip}"
                    Command="{Binding SkipCommand}"
                    Margin="0,0,8,0" />
            <Button Grid.Row="1" Grid.Column="3"
                    Classes="accent"
                    Content="{Binding NextLabel}"
                    Command="{Binding NextCommand}"
                    IsEnabled="{Binding CanAdvance}" />
        </Grid>
    </Grid>
</Window>
