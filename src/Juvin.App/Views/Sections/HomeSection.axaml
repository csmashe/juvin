<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juvin.App.ViewModels.Sections"
             xmlns:loc="using:Juvin.App.Localization"
             xmlns:shell="using:Juvin.App.ViewModels"
             x:Class="Juvin.App.Views.Sections.HomeSection"
             x:DataType="vm:HomeSectionViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="860" Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Classes="page-title" Text="{loc:Str Home.Title}" />
                <TextBlock Classes="page-subtitle" Text="{loc:Str Home.Subtitle}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="{loc:Str Home.StatusLabel}" />
                <Border Classes="panel">
                    <StackPanel>
                        <Border Classes="section-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str Home.Connector}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str Home.ConnectorHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Classes="badge-text" Text="{Binding ConnectorStatus}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str Home.Model}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str Home.ModelHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Classes="badge-text" Text="{Binding ModelStatus}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str Home.Shortcut}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str Home.ShortcutHint}" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Classes="badge-text" Text="{Binding ShortcutStatus}" />
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="{loc:Str Home.RecentLabel}" />
                <Border Classes="panel">
                    <StackPanel>
                        <Border Classes="section-row" IsVisible="{Binding !HasRecentRewrites}">
                            <TextBlock Classes="row-hint" Margin="0" Text="{Binding RecentHint}" />
                        </Border>
                        <!-- ReSharper disable once Xaml.StyleClassNotFound (the class is matched by a compound selector in JuvinStyles) -->
                        <ItemsControl Classes="divided-rows" ItemsSource="{Binding RecentRewrites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentRewriteRow">
                                    <Border Classes="section-row">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Classes="row-title" Text="{Binding Title}" />
                                                <TextBlock Classes="row-hint" Text="{Binding Subject}" />
                                                <TextBlock Classes="row-hint" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Classes="badge" IsVisible="{Binding Applied}">
                                                <TextBlock Classes="badge-text" Text="{loc:Str Home.Applied}" />
                                            </Border>
                                            <Button Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Content="{loc:Str Home.Copy}"
                                                    Command="{Binding $parent[ItemsControl].((vm:HomeSectionViewModel)DataContext).CopyCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Content="{loc:Str Home.Delete}"
                                                    Command="{Binding $parent[ItemsControl].((vm:HomeSectionViewModel)DataContext).DeleteCommand, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="section-row divided" IsVisible="{Binding HasError}">
                            <TextBlock Classes="row-hint" Margin="0" Text="{Binding ErrorMessage}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="{loc:Str Home.SetupLabel}" />
                <Border Classes="panel">
                    <StackPanel>
                        <Border Classes="section-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str Home.Setup}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str Home.SetupHint}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{loc:Str Common.OpenSetupWizard}"
                                        Command="{Binding $parent[Window].((shell:MainWindowViewModel)DataContext).OpenWizardCommand, FallbackValue={x:Null}}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
