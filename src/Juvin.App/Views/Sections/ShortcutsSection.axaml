<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juvin.App.ViewModels.Sections"
             xmlns:controls="using:Juvin.App.Views.Controls"
             xmlns:loc="using:Juvin.App.Localization"
             x:Class="Juvin.App.Views.Sections.ShortcutsSection"
             x:DataType="vm:ShortcutsSectionViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="860" Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Classes="page-title" Text="{loc:Str Shortcuts.Title}" />
                <TextBlock Classes="page-subtitle" Text="{loc:Str Shortcuts.Subtitle}" />
            </StackPanel>

            <controls:ShortcutPanel DataContext="{Binding Panel}" />

            <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="{loc:Str Shortcuts.BrowserLabel}" />
                <Border Classes="panel">
                    <Border Classes="section-row">
                        <StackPanel>
                            <TextBlock Classes="row-title" Text="{loc:Str Shortcuts.ExtensionMirror}" />
                            <TextBlock Classes="row-hint" Text="{loc:Str Shortcuts.ExtensionMirrorHint}" />
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
