<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juvin.App.ViewModels.Sections"
             xmlns:loc="using:Juvin.App.Localization"
             x:Class="Juvin.App.Views.Sections.PrivacyAndDataSection"
             x:DataType="vm:PrivacyAndDataSectionViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="860" Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Classes="page-title" Text="{loc:Str PrivacyAndData.Title}" />
                <TextBlock Classes="page-subtitle" Text="{loc:Str PrivacyAndData.Subtitle}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="{loc:Str PrivacyAndData.HistoryLabel}" />
                <Border Classes="panel">
                    <StackPanel>
                        <Border Classes="section-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str PrivacyAndData.History}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str PrivacyAndData.HistoryHint}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding HistoryEnabled}" />
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided">
                            <Grid ColumnDefinitions="*,220" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str PrivacyAndData.Retention}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str PrivacyAndData.RetentionHint}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding RetentionOptions}"
                                          SelectedItem="{Binding SelectedRetention}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RetentionOption">
                                            <TextBlock Text="{Binding Title}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str PrivacyAndData.Provenance}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str PrivacyAndData.ProvenanceHint}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ProvenanceCaptureEnabled}" />
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str PrivacyAndData.Crash}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str PrivacyAndData.CrashHint}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsEnabled="{Binding IsCrashReportingAvailable}"
                                              IsChecked="{Binding CrashReportingEnabled}" />
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided" IsVisible="{Binding !IsCrashReportingAvailable}">
                            <TextBlock Classes="row-hint" Margin="0" Text="{loc:Str PrivacyAndData.CrashUnavailable}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="section-label" Text="{loc:Str PrivacyAndData.StorageLabel}" />
                <Border Classes="panel">
                    <StackPanel>
                        <Border Classes="section-row">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str PrivacyAndData.DataFolder}" />
                                    <TextBlock Classes="row-hint" Text="{Binding DataFolder}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{loc:Str PrivacyAndData.OpenFolder}"
                                        Click="OnOpenFolderClick" />
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str PrivacyAndData.SavedHistory}" />
                                    <TextBlock Classes="row-hint" Text="{Binding HistorySummary}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{loc:Str PrivacyAndData.Export}"
                                        IsEnabled="{Binding HasEntries}"
                                        Click="OnExportClick" />
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str PrivacyAndData.Clear}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str PrivacyAndData.ClearHint}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{loc:Str PrivacyAndData.Clear}"
                                        Command="{Binding RequestClearCommand}"
                                        IsVisible="{Binding !IsConfirmingClear}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsConfirmingClear}">
                                    <Button Content="{loc:Str PrivacyAndData.ConfirmClear}" Command="{Binding ConfirmClearCommand}" />
                                    <Button Content="{loc:Str PrivacyAndData.Cancel}" Command="{Binding CancelClearCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Classes="row-title" Text="{loc:Str PrivacyAndData.DeleteAll}" />
                                    <TextBlock Classes="row-hint" Text="{loc:Str PrivacyAndData.DeleteAllHint}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="{loc:Str PrivacyAndData.DeleteAll}"
                                        Command="{Binding RequestDeleteAllCommand}"
                                        IsVisible="{Binding !IsConfirmingDeleteAll}" />
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsConfirmingDeleteAll}">
                                    <Button Content="{loc:Str PrivacyAndData.ConfirmDeleteAll}" Command="{Binding ConfirmDeleteAllCommand}" />
                                    <Button Content="{loc:Str PrivacyAndData.Cancel}" Command="{Binding CancelDeleteAllCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="section-row divided" IsVisible="{Binding HasError}">
                            <TextBlock Classes="row-hint" Margin="0" Text="{Binding ErrorMessage}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
