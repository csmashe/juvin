<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Juvin.App.ViewModels.Sections"
             xmlns:controls="using:Juvin.App.Views.Controls"
             xmlns:loc="using:Juvin.App.Localization"
             x:Class="Juvin.App.Views.Sections.BrowserConnectorSection"
             x:DataType="vm:BrowserConnectorSectionViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28" MaxWidth="860" Spacing="22">
            <StackPanel Spacing="6">
                <TextBlock Classes="page-title" Text="{loc:Str BrowserConnector.Title}" />
                <TextBlock Classes="page-subtitle" Text="{loc:Str BrowserConnector.Subtitle}" />
            </StackPanel>

            <controls:BrowserConnectorPanel DataContext="{Binding Panel}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
