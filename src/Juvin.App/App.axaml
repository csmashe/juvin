<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Juvin.App.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#F5A623" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Styles/JuvinStyles.axaml" />
    </Application.Styles>
</Application>
