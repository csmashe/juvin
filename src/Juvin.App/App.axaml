<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Juvin.App.App"
             Name="Juvin"
             RequestedThemeVariant="Dark">

    <!-- macOS shows this menu under the app name; without it Avalonia adds an "About Avalonia" item. Start fills it in. -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem />
        </NativeMenu>
    </NativeMenu.Menu>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#F5A623" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="/Styles/JuvinStyles.axaml" />
    </Application.Styles>
</Application>
