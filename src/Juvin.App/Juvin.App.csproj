<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Juvin.App</RootNamespace>
        <AssemblyName>juvin</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>..\..\assets\brand\ico\juvin.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Juvin.App.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="FluentIcons.Avalonia"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\*.png"/>
        <Content Include="Assets\juvin-mark-color-32.png" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Juvin.Core\Juvin.Core.csproj"/>
        <ProjectReference Include="..\Juvin.Platform\Juvin.Platform.csproj"/>
        <ProjectReference Include="..\Juvin.Platform.Linux\Juvin.Platform.Linux.csproj"/>
        <ProjectReference Include="..\Juvin.Platform.Mac\Juvin.Platform.Mac.csproj"/>
        <ProjectReference Include="..\Juvin.Platform.Windows\Juvin.Platform.Windows.csproj"/>
    </ItemGroup>

    <!-- Ships juvin-host next to the app without referencing it for compilation; OutputItemType also copies juvin-host.dll, which a plain reference leaves out. -->
    <ItemGroup>
        <ProjectReference Include="..\Juvin.NativeHost\Juvin.NativeHost.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Content"
                          CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
