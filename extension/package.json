{
  "name": "juvin-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Juvin browser extension for Chrome and Firefox.",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
