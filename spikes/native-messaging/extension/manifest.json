{
  "manifest_version": 3,
  "name": "Juvin native messaging spike",
  "version": "0.0.1",
  "description": "Throwaway: connects to the juvin-nm-spike host and records a round trip.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Juvin spike"
  },
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "spike@juvin.app",
      "strict_min_version": "128.0"
    }
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}