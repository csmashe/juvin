#!/usr/bin/env bpftrace
// Prints every connect() and every addressed sendto() or sendmsg() the given process makes, for
// the acceptance checklist's "no external request" scenario. Data on a connected socket can only
// reach the peer the connect() named, so these probes cover every destination the process reaches.
// Usage: sudo bpftrace scripts/dev/trace-connects.bt $(pgrep -x juvin)
tracepoint:syscalls:sys_enter_connect /pid == $1/ {
  $sa = (struct sockaddr_in *)args->uservaddr;
  if ($sa->sin_family == 2) {
    printf("connect v4 %s:%d\n", ntop($sa->sin_addr.s_addr), (($sa->sin_port >> 8) | (($sa->sin_port & 0xff) << 8)));
  } else if ($sa->sin_family == 10) {
    $s6 = (struct sockaddr_in6 *)args->uservaddr;
    printf("connect v6 %s:%d\n", ntop($s6->sin6_addr.in6_u.u6_addr8), (($s6->sin6_port >> 8) | (($s6->sin6_port & 0xff) << 8)));
  } else {
    printf("connect family %d\n", $sa->sin_family);
  }
}
tracepoint:syscalls:sys_enter_sendto /pid == $1 && args->addr != 0/ {
  $sa = (struct sockaddr_in *)args->addr;
  if ($sa->sin_family == 2) {
    printf("sendto v4 %s:%d\n", ntop($sa->sin_addr.s_addr), (($sa->sin_port >> 8) | (($sa->sin_port & 0xff) << 8)));
  } else if ($sa->sin_family == 10) {
    $s6 = (struct sockaddr_in6 *)args->addr;
    printf("sendto v6 %s:%d\n", ntop($s6->sin6_addr.in6_u.u6_addr8), (($s6->sin6_port >> 8) | (($s6->sin6_port & 0xff) << 8)));
  } else {
    printf("sendto family %d\n", $sa->sin_family);
  }
}
tracepoint:syscalls:sys_enter_sendmsg /pid == $1/ {
  $msg = (struct user_msghdr *)args->msg;
  if ($msg->msg_name != 0) {
    $sa = (struct sockaddr_in *)$msg->msg_name;
    if ($sa->sin_family == 2) {
      printf("sendmsg v4 %s:%d\n", ntop($sa->sin_addr.s_addr), (($sa->sin_port >> 8) | (($sa->sin_port & 0xff) << 8)));
    } else if ($sa->sin_family == 10) {
      $s6 = (struct sockaddr_in6 *)$msg->msg_name;
      printf("sendmsg v6 %s:%d\n", ntop($s6->sin6_addr.in6_u.u6_addr8), (($s6->sin6_port >> 8) | (($s6->sin6_port & 0xff) << 8)));
    } else {
      printf("sendmsg family %d\n", $sa->sin_family);
    }
  }
}
